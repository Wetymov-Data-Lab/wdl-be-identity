# -------------------------------------------------------------
# Application
# -------------------------------------------------------------

APP_VERSION=0.1.0
PROJECT_NAME=WDL Identity API
PROJECT_DESC=API аутентификации и управления учетными записями
DEBUG=False
API_EXPOSE_PORT=8002
LOG_LEVEL=INFO
LOG_JSON=False

CORS_DISABLE=True
CORS_REGEX=https://.*\.wdl\.ru
PROD_SERVER_URL=


# -------------------------------------------------------------
# PostgreSQL
# -------------------------------------------------------------

POSTGRES_SERVER=localhost
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=wdl_identity
POSTGRES_PORT=5432
SQLALCHEMY_ECHO=False
DATABASE_CREATE_TABLES=True
POSTGRES_DOCKER_SERVER=postgres
POSTGRES_DOCKER_PORT=5432


# -------------------------------------------------------------
# OAuth / JWT
# -------------------------------------------------------------

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=wdl-identity
JWT_AUDIENCE=wdl-api
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30


# -------------------------------------------------------------
# Redis
# -------------------------------------------------------------

REDIS_HOST=127.0.0.1
REDIS_DOCKER_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=
REDIS_KEY_PREFIX=wdl:identity
